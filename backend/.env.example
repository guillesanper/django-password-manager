# =============================================================================
# PLANTILLA — cópiala a `backend/.env` y rellena cada valor.
#   cp .env.example .env
# Este fichero SÍ se versiona: no escribas aquí ningún secreto real.
#
# Docker Compose lee `backend/.env` tanto para interpolar ${VAR} en
# docker-compose.yml como vía `env_file` en el servicio `web`.
# =============================================================================

# --- Django ------------------------------------------------------------------
# OBLIGATORIA: sin ella Django falla al arrancar (settings.py usa os.environ,
# sin fallback, para que nunca se firmen JWT con una clave conocida).
# Generar:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Nunca `true` en producción.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_VITE_DEV_MODE=false

# Activar SÓLO cuando nginx sirva HTTPS y propague X-Forwarded-Proto; en otro
# caso SECURE_SSL_REDIRECT provoca un bucle de redirección infinito.
# Requiere que existan infrastructure/nginx/ssl/{fullchain,privkey}.pem — ver el
# README de ese directorio.
DJANGO_TLS_ENABLED=true

# max-age de Strict-Transport-Security, en segundos.
# 31536000 (1 año) en el dominio real; con ese valor se activan además
# includeSubDomains y preload. En local, un valor corto (p. ej. 300): HSTS se
# aplica por host ignorando el puerto, y un año sobre `localhost` forzaría HTTPS
# en todos los servidores de desarrollo de la máquina, de forma irreversible
# hasta que expire.
DJANGO_HSTS_SECONDS=31536000

# Listas separadas por comas, con esquema y puerto.
# CSRF_TRUSTED_ORIGINS debe incluir el origen HTTPS desde el que se sirve la SPA.
CORS_ALLOWED_ORIGINS=http://localhost:5174
CSRF_TRUSTED_ORIGINS=https://localhost,http://localhost:5174

# --- Confianza en los proxies (A4) -------------------------------------------
# Direcciones (CIDR) desde las que se acepta X-Forwarded-For. Si el par TCP
# directo no está aquí, la cabecera se ignora entera y se usa REMOTE_ADDR.
#
# Debe ser la IP FIJA de nginx y nada más: docker-compose.yml declara la subred
# 172.28.0.0/24 en app-network y le reserva la .10, fuera del rango de asignación
# dinámica. Un /32, no un rango: confiar en los rangos privados enteros deja que
# cualquier cosa que alcance a gunicorn desde dentro de la red —el host incluido,
# por el puerto que publica el override de desarrollo— falsifique la cadena y
# provoque el bloqueo de la IP de un tercero.
#
# Si delante hay un CDN o balanceador, añade SU dirección y sube los saltos.
DJANGO_TRUSTED_PROXIES=172.28.0.10/32

# Número de proxies que añaden su salto a X-Forwarded-For. 1 = sólo nginx.
# Súbelo a 2 si delante hay un CDN o balanceador que también añada el suyo; si te
# quedas corto se registrará la IP del proxy, y si te pasas, una falsificable.
DJANGO_TRUSTED_PROXY_HOPS=1

# --- PostgreSQL --------------------------------------------------------------
# POSTGRES_PASSWORD sólo se aplica en el initdb del volumen. Sobre un volumen
# ya existente hay que rotarla dentro de la base:
#   docker compose exec db psql -U <user> -d <db> -c "ALTER USER <user> WITH PASSWORD '<nueva>';"
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- Redis -------------------------------------------------------------------
# REDIS_PASSWORD alimenta `--requirepass`; las dos URL deben incluirla como
# `redis://:<password>@redis:6379/<db>`. Usa bases distintas (1 caché, 2 sesiones).
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/1
REDIS_SESSIONS_URL=redis://:<REDIS_PASSWORD>@redis:6379/2

# --- Cifrado de aplicación ---------------------------------------------------
# Clave Fernet para el cifrado de sesión (obligatoria). Nada que ver con MinIO:
# la vieja ENCRYPTION_KEY (capa Fernet at-rest de ficheros) se retiró en el paso 28
# —redundante sobre el cifrado de cliente; el at-rest lo aporta ahora la SSE-S3 de MinIO—.
# Generar:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# --- MinIO -------------------------------------------------------------------
# Las credenciales root se releen en cada arranque: rotar = reiniciar.
# ACCESS/SECRET_KEY son las que usa Django; pueden coincidir con las root o ser
# de una cuenta de servicio con permisos acotados al bucket.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=user-encrypted-files
MINIO_USE_SSL=false
# KMS integrado de MinIO para SSE-S3 (cifrado at-rest local, gratis, sin nube ni KES).
# Formato: <nombre-clave>:<32 bytes en base64>. Generar el trozo base64:
#   openssl rand -base64 32
# p. ej.: MINIO_KMS_SECRET_KEY=minio-default-key:UMe...=  (nombre arbitrario)
MINIO_KMS_SECRET_KEY=

# --- Grafana -----------------------------------------------------------------
# Igual que Postgres: sólo aplica en la creación del volumen. Después:
#   docker compose exec grafana grafana-cli admin reset-admin-password '<nueva>'
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
