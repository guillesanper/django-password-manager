{
  "uid": "backend-app",
  "title": "Backend Application Dashboard",
  "tags": [
    "backend",
    "minio",
    "django",
    "postgres"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "MinIO - Capacidad",
      "type": "stat",
      "targets": [
        {
          "expr": "minio_cluster_capacity_usable_free_bytes",
          "legendFormat": "Libre",
          "refId": "A"
        },
        {
          "expr": "minio_cluster_capacity_usable_total_bytes",
          "legendFormat": "Total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "MinIO - Peticiones S3",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (api) (rate(minio_s3_requests_total[5m]))",
          "legendFormat": "{{api}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Django - Respuestas HTTP",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (method, status) (rate(django_http_responses_total_by_status_view_method_total[5m]))",
          "legendFormat": "{{method}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "PostgreSQL - Conexiones activas",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "Conexiones",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "MinIO - Objetos por bucket",
      "type": "table",
      "targets": [
        {
          "expr": "minio_bucket_usage_object_total",
          "legendFormat": "{{bucket}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s"
}
