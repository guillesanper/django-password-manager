# =============================================================================
# PLANTILLA — cópiala a `backend/.env.db` y rellena cada valor (N18).
#   cp .env.db.example .env.db
# Este fichero SÍ se versiona: no escribas aquí ningún secreto real.
#
# Credenciales de Postgres que `web` NO debe tener. Sólo las leen los servicios
# `db`, `db-roles`, `migrate` y `backup` (env_file en docker-compose.yml). Antes
# vivían en backend/.env, que `web` lee entero: con un fallo en la app, quien lo
# aprovechara tenía también la contraseña del superusuario.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# Superusuario del initdb. POSTGRES_PASSWORD sólo se aplica al crear el volumen;
# sobre uno existente hay que rotarla dentro de la base:
#   docker compose exec db psql -U <user> -d <db> -c "ALTER USER <user> WITH PASSWORD '<nueva>';"
# Instalaciones anteriores a N18: mueve aquí POSTGRES_USER y POSTGRES_PASSWORD
# desde backend/.env, con los mismos valores.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=

# Dueño del esquema: aplica las migraciones (servicio `migrate`) y hace las copias
# (servicio `backup`). Lo crea `db-roles`; la contraseña se puede cambiar aquí.
DB_MIGRATE_USER=migraciones
DB_MIGRATE_PASSWORD=
